# Public Supabase client configuration only. No service-role key is used.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fails closed unless explicitly true; database kill switch, verified email,
# lifetime allowance / active allowlist and shared rolling quotas also apply.
# Public access is opted in ONLY via pilot_config.public_free_enabled (default false).
INKSTORY_GENERATION_ENABLED=false
# Server-only provider credential. Never expose with a NEXT_PUBLIC prefix.
OPENAI_API_KEY=
